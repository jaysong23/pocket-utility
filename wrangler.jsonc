{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-utility",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.mjs",
  "ratelimits": [
    {
      "name": "URL_RATE_LIMITER",
      "namespace_id": "2026111601",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "visitor-counter-v1",
      "new_sqlite_classes": [
        "VisitorCounter"
      ]
    }
  ]
}
